@startuml Context Diagram
!include <C4/C4_Context>
!include <C4/C4_Container>

title Диаграмма контекста - Система открытия депозитов

Person(клиент_новый, "Новый клиент", "Подает заявку на депозит через сайт")
Person(клиент_сущ, "Существующий клиент", "Подает заявку через интернет-банк")
Person(менеджер_кц, "Менеджер кол-центра", "Обрабатывает заявки новых клиентов")
Person(менеджер_бо, "Менеджер бэк-офиса", "Подтверждает заявки в АБС")

System(сайт, "Сайт банка", "PHP + React.js, прием заявок от новых клиентов")
System(интернет_банк, "Интернет-банк", "ASP.NET MVC, обслуживание существующих клиентов")
System(абс, "АБС", "Основная банковская система, Delphi + Oracle")
System(кц_система, "Система кол-центра", "Java Spring Boot, обработка обращений")
System(смс_шлюз, "СМС-шлюз", "Отправка уведомлений клиентам")

Rel(клиент_новый, сайт, "Просматривает депозиты, подает заявку")
Rel(клиент_сущ, интернет_банк, "Подает заявку, подтверждает SMS")
Rel(менеджер_кц, кц_система, "Обрабатывает заявки, звонит клиентам")
Rel(менеджер_бо, абс, "Подтверждает заявки, управляет депозитами")

Rel(сайт, кц_система, "Передает заявки новых клиентов")
Rel(интернет_банк, абс, "Обменивается данными о заявках")
Rel(интернет_банк, смс_шлюз, "Отправляет SMS для подтверждения")
Rel(абс, смс_шлюз, "Отправляет уведомления об открытии депозитов")
Rel(кц_система, абс, "Синхронизирует данные по заявкам")

@enduml